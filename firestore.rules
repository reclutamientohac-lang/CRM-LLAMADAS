rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function esAdmin() {
      return isEmailVerified() && userEmail() == 'reclutamientohac@gmail.com';
    }

    function existeDocAutorizado() {
      return exists(/databases/$(database)/documents/usuariosAutorizados/$(userEmail()));
    }

    function getDocAutorizado() {
      return get(/databases/$(database)/documents/usuariosAutorizados/$(userEmail())).data;
    }

    function esAutorizado() {
      return esAdmin() || (isEmailVerified() && existeDocAutorizado() && getDocAutorizado().activo == true && getDocAutorizado().rol == 'Telemarketing' && getDocAutorizado().telemarketingVinculada is string && getDocAutorizado().telemarketingVinculada.size() > 0 && getDocAutorizado().telemarketingVinculada != 'SIN ASIGNAR');
    }

    function rolActual() {
      return esAdmin() ? 'Administrador' : (existeDocAutorizado() ? getDocAutorizado().rol : '');
    }

    function esSupervisor() {
      return esAdmin();
    }

    function telemarketingActual() {
      return esAutorizado() && existeDocAutorizado() && 'telemarketingVinculada' in getDocAutorizado() ?
        getDocAutorizado().telemarketingVinculada : '';
    }

    function esPropietarioAsignado(data) {
      return esAutorizado() && data.idProspecto is string &&
        get(/databases/$(database)/documents/prospectos/$(data.idProspecto)).data.telemarketing == telemarketingActual();
    }

    match /respaldos/{id} { allow read, write: if esAdmin(); }
    match /logRestauraciones/{id} { allow read, write: if esAdmin(); }
    match /reportesGuardados/{id} { allow read, write: if esAdmin(); }
    match /auditoria/{id} {
      allow read: if esSupervisor();
      allow create: if esAutorizado() && request.resource.data.usuario == userEmail();
      allow update, delete: if esAdmin();
    }
    match /logAsignaciones/{id} {
      allow read: if esSupervisor();
      allow create: if esAutorizado() && request.resource.data.usuario == userEmail() && (esSupervisor() || esPropietarioAsignado(request.resource.data));
      allow update, delete: if esAdmin();
    }
    // Extensión explícita del registro. Solo colecciones nuevas; las existentes conservan sus reglas.
    match /{collectionName}/{id} {
      allow read, write: if esAdmin() && exists(/databases/$(database)/documents/settings/backupRegistry) && collectionName in get(/databases/$(database)/documents/settings/backupRegistry).data.collections && !(collectionName in ['usuariosAutorizados','respaldos','logRestauraciones','auditoria','prospectos','gestiones','citas','retroalimentaciones','ventas','logVentas','logCargas','solicitudesAcceso','logAccesos','reportesGuardados','settings','users','logAsignaciones','calendarJobs']);
    }

    // Colección: usuariosAutorizados
    match /usuariosAutorizados/{emailDoc} {
      allow get: if esAdmin() || (isEmailVerified() && userEmail() == emailDoc.lower());
      allow list: if esAdmin();
      allow create: if esAdmin();
      allow delete: if esAdmin() && emailDoc.lower() != 'reclutamientohac@gmail.com';
      allow update: if (esAdmin() && (emailDoc.lower() != 'reclutamientohac@gmail.com' || request.resource.data.activo == true)) || (
        isEmailVerified() &&
        userEmail() == emailDoc.lower() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcceso'])
      );
    }

    // Colección: solicitudesAcceso
    match /solicitudesAcceso/{solicitudId} {
      allow create: if isEmailVerified() &&
        userEmail() == solicitudId.lower() &&
        request.resource.data.email.lower() == userEmail();
      allow get: if esAdmin() || (isEmailVerified() && userEmail() == solicitudId.lower());
      allow list, update, delete: if esAdmin();
    }

    // Colección: logAccesos
    match /logAccesos/{logId} {
      allow read, write: if esAdmin();
    }

    // Colección: settings
    match /settings/{settingId} {
      allow read: if esAutorizado();
      allow write: if settingId != 'calendarCentral' && ((settingId in ['backupParameters','backupRegistry']) ? esAdmin() : esSupervisor());
    }

    // Colección: logCargas
    match /logCargas/{logId} {
      allow read, write: if esSupervisor();
    }

    // Colección: gestiones
    match /gestiones/{gestionId} {
      allow read: if esSupervisor() || esPropietarioAsignado(resource.data);
      allow create: if esSupervisor() || esPropietarioAsignado(request.resource.data);
      allow update: if esSupervisor() || (esPropietarioAsignado(resource.data) && esPropietarioAsignado(request.resource.data));
      allow delete: if esSupervisor();
    }

    function centralActiva() {
      return exists(/databases/$(database)/documents/settings/calendarCentral) &&
        get(/databases/$(database)/documents/settings/calendarCentral).data.enabled == true;
    }
    function camposDeProcesamiento() {
      return ['calendarSyncDone','calendarCentralDone','calendarSyncLease','calendarSyncLeaseUntil'];
    }
    // Cola privada: solo el SDK del servidor; tampoco entra en respaldos extensibles.
    match /calendarJobs/{jobId} { allow read, write: if false; }

    // Colección: citas
    match /citas/{citaId} {
      allow read: if esSupervisor() || esPropietarioAsignado(resource.data);
      allow create: if (esSupervisor() || esPropietarioAsignado(request.resource.data)) &&
        (!centralActiva() || !request.resource.data.keys().hasAny(camposDeProcesamiento()));
      allow update: if (esSupervisor() || (esPropietarioAsignado(resource.data) && esPropietarioAsignado(request.resource.data))) &&
        (!centralActiva() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDeProcesamiento()));
      allow delete: if esSupervisor();
    }

    // Colección: retroalimentaciones
    match /retroalimentaciones/{retroId} {
      allow read: if esSupervisor() || esPropietarioAsignado(resource.data);
      allow create: if esSupervisor() || esPropietarioAsignado(request.resource.data);
      allow update, delete: if esSupervisor();
    }

    // Colección: ventas
    match /ventas/{ventaId} {
      allow read: if esSupervisor() || (
        esPropietarioAsignado(resource.data)
      );
      allow create: if esAdmin() || esPropietarioAsignado(request.resource.data);
      allow update: if esSupervisor();
      allow delete: if esSupervisor();
    }

    // Colección: logVentas
    match /logVentas/{logId} {
      allow read: if esSupervisor();
      allow create: if esSupervisor();
      allow update, delete: if esAdmin();
    }

    // Colección: prospectos
    match /prospectos/{prospectoId} {
      allow get: if esAutorizado() && (
        esSupervisor() ||
        resource.data.telemarketing == telemarketingActual()
      );
      
      allow list: if esAutorizado() && (
        esSupervisor() ||
        resource.data.telemarketing == telemarketingActual()
      );

      allow create: if esAdmin();

      allow update: if esAutorizado() && (
        esSupervisor() ||
        (resource.data.telemarketing == telemarketingActual() && request.resource.data.telemarketing == telemarketingActual())
      );

      allow delete: if esAdmin();
    }

    // Colección legacy: users
    match /users/{userId} {
      allow read, write: if esAdmin();
    }
  }
}
