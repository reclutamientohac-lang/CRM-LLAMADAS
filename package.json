{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/stage78.test.ts",
    "test:rules": "firebase emulators:exec --project demo-crm-llamadas --only firestore \"node --import tsx --test tests/rules.test.ts tests/seller-rules.test.ts tests/security.test.ts\"",
    "test:pipeline": "node --import tsx --test tests/pipeline.test.ts",
    "check:integrity": "node scripts/check-integrity.mjs",
    "test:integrity": "node --test tests/integrity.test.mjs",
    "predev": "npm run check:integrity",
    "prebuild": "npm run verify",
    "verify": "npm run check:integrity && npm run lint && npm test && npm run test:pipeline && npm run test:integrity && npm run test:seller && npm run test:money",
    "pretest": "npm run check:integrity",
    "test:seller": "node --import tsx --test tests/seller.test.ts",
    "test:money": "node --import tsx --test tests/money.test.ts",
    "verify:release": "npm run build && npm run test:rules"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^12.19.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "firebase-tools": "^14.17.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "typescript-compiler-api": "npm:typescript@5.9.3"
  }
}
